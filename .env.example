# Optional API Gateway base URL after a backend deployment, for example:
# VITE_API_BASE_URL=https://example.execute-api.ap-south-1.amazonaws.com/dev
# Explicitly opt individual modules into the authenticated API. Keep demo mode
# unless Cognito authentication and the deployed API are configured.
# VITE_DEVELOPER_PASSPORT_MODE=api
# VITE_PROJECT_COLLABORATION_MODE=api
# Cognito configuration is required for sign-in and protected API mode.
# These values are public identifiers only; never add a client secret or AWS key.
# VITE_COGNITO_REGION=ap-south-1
# VITE_COGNITO_USER_POOL_ID=<CloudFormation UserPoolId output>
# VITE_COGNITO_USER_POOL_CLIENT_ID=<CloudFormation UserPoolClientId output>
# Never place credentials, Cognito secrets, or private tokens in this file.
